# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Env files, never commit
.env
.env.*
!.env.example

# private keys and certs, never commit (the relay reads its dfns key from
# a mounted secret, not the repo)
*.pem
*.key
*.p12
*.pfx
*.pkcs8

# Local backups
*.backup-*
*.bak
*.orig
*.rej
*~

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
screenshots/
test-results/

# local-only working files, never pushed. any _local/ folder in the tree counts
_local/
**/_local/
_docs/
notes/
docs/*.md
docs/*.json
NOTES.md
CHANGELOG.md
# grafana provisioning + dashboards, kept local with the rest of the ops setup
monitoring/

# build artefacts not worth committing
.vercel/
coverage/
playwright-report/
*.tsbuildinfo
.vite/
.cache/

# browser profile for local wallet testing
.wallet-test-profile/

# OS leaks beyond .DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# alt lockfiles (we use npm)
pnpm-lock.yaml
yarn.lock
bun.lockb
