#!/bin/sh
# Forced command of the CI relay key (account bff-deploy, authorized_keys: command="/usr/local/bin/relay-deploy").
# Reads a gzipped tar of the repo (git archive) on stdin, installs its runtime dependencies without
# their install scripts and restarts the relay on it. A release that does not stay up on /health is
# replaced by the previous one. The client only picks the release id, which must be a commit sha.
set -eu

release="${SSH_ORIGINAL_COMMAND:-}"
case "$release" in "" | *[!0-9a-f]*) echo "relay-deploy: the release id must be a commit sha" >&2; exit 2 ;; esac
if [ "${#release}" -lt 7 ] || [ "${#release}" -gt 40 ]; then echo "relay-deploy: bad release id" >&2; exit 2; fi

base=/srv/lobster-bff
unit=lobster-bff.service

exec 9>"$base/.deploy.lock"
flock -n 9 || { echo "relay-deploy: another upload is still running" >&2; exit 6; }

prop() { systemctl show -p "$1" --value "$unit"; }
answers() { curl -fsS --connect-timeout 2 --max-time 5 http://127.0.0.1:8787/health >/dev/null 2>&1; }

# up, then still the same process 8 s later without an automatic restart in between, so a release
# that crashes and comes back in a loop is not taken for a healthy one
healthy() {
	restarts="$(prop NRestarts)"
	deadline=$(($(date +%s) + 120))
	while [ "$(date +%s)" -lt "$deadline" ]; do
		if answers; then
			pid="$(prop MainPID)"
			sleep 8
			answers && [ "$(prop ActiveState)" = active ] && [ "$pid" != 0 ] &&
				[ "$(prop MainPID)" = "$pid" ] && [ "$(prop NRestarts)" = "$restarts" ]
			return
		fi
		sleep 1
	done
	return 1
}

switch_to() {
	ln -sfn "$1" "$base/.current.new"
	mv -T "$base/.current.new" "$base/current"
	sudo -n /usr/bin/systemctl restart "$unit"
}

incoming="$base/releases/.incoming-$release-$$"
mkdir "$incoming"
trap 'rm -rf "$incoming"' EXIT
trap 'exit 1' HUP INT TERM PIPE
tar -xzf - -C "$incoming" --no-same-owner --no-same-permissions
[ -f "$incoming/server/index.ts" ] && [ -f "$incoming/package-lock.json" ] ||
	{ echo "relay-deploy: the upload is not the repo" >&2; exit 3; }
(cd "$incoming" && npm ci --omit=dev --ignore-scripts --no-audit --no-fund --loglevel=error --cache "$base/.npm-cache")

prev=""
if [ -L "$base/current" ]; then prev="$(readlink -f "$base/current")"; fi
dest="$base/releases/$(date -u +%Y%m%d%H%M%S)-$release"
mv "$incoming" "$dest"
trap - EXIT

if ! switch_to "$dest" || ! healthy; then
	echo "relay-deploy: $release does not stay up on /health" >&2
	if [ -n "$prev" ] && [ -d "$prev" ]; then
		switch_to "$prev" || true
		rm -rf "$dest"
		if healthy; then
			echo "relay-deploy: the previous release is back and answers" >&2
			exit 4
		fi
	fi
	echo "relay-deploy: no release answers, look at the env or the host" >&2
	exit 5
fi

# each release carries its own node_modules: keep three, never the one in use, and clear uploads
# that were cut off more than a day ago
cur="$(readlink -f "$base/current")"
ls -1d "$base"/releases/[0-9]* | sort | head -n -3 | while read -r old; do
	[ "$old" = "$cur" ] || rm -rf "$old"
done
find "$base/releases" -maxdepth 1 -name '.incoming-*' -mmin +1440 -exec rm -rf {} +
echo "relay-deploy: the relay answers on $release"
